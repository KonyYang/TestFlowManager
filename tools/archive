"""
简单启动性能测试 - 测量应用从启动到主窗口显示的时间
"""
import time
import sys
from pathlib import Path

# 添加到Python路径
project_root = Path(__file__).parent.parent
sys.path.insert(0, str(project_root))

print("="*80)
print("TestFlowManager 启动性能测试")
print("="*80)
print()

start_time = time.time()

print("步骤1: 导入核心模块...")
t1 = time.time()
from src.core.config_manager import config_manager
from src.core.logger import logger
print(f"  ✅ 耗时: {time.time() - t1:.3f}秒")

print("\n步骤2: 导入主窗口UI...")
t2 = time.time()
from src.features.main_window.view.main_window_ui import MainWindow
print(f"  ✅ 耗时: {time.time() - t2:.3f}秒")

print("\n步骤3: 创建QApplication...")
t3 = time.time()
from PyQt5.QtWidgets import QApplication
app = QApplication(sys.argv)
print(f"  ✅ 耗时: {time.time() - t3:.3f}秒")

print("\n步骤4: 实例化主窗口...")
t4 = time.time()
window = MainWindow()
print(f"  ✅ 耗时: {time.time() - t4:.3f}秒")

total_time = time.time() - start_time

print()
print("="*80)
print("性能汇总")
print("="*80)
print(f"\n总启动时间: {total_time:.3f}秒\n")

if total_time < 0.5:
    print("🎉 优秀! 启动时间 < 0.5秒")
elif total_time < 1.0:
    print("👍 良好! 启动时间 < 1.0秒")
elif total_time < 2.0:
    print("⚠️  一般。启动时间 < 2.0秒,建议继续优化")
else:
    print("🔴 较慢。启动时间 > 2.0秒,需要立即优化")

print()
print("各阶段耗时:")
print(f"  核心模块:   {(t2-t1):.3f}s ({(t2-t1)/total_time*100:.1f}%)")
print(f"  主窗口UI:   {(t3-t2):.3f}s ({(t3-t2)/total_time*100:.1f}%)")
print(f"  QApplication: {(t4-t3):.3f}s ({(t4-t3)/total_time*100:.1f}%)")
print(f"  窗口实例化:  {(time.time()-start_time-(t4-start_time)):.3f}s")

print()
print("="*80)

# 不显示窗口,直接退出
sys.exit(0)
